# ── 设备配置 ────────────────────────────────────────────────
DEVICE=cuda                        # cuda | cpu
TORCH_DTYPE=float16                # float16 | bfloat16 | float32
VRAM_BUDGET_GB=10.0                # 触发 offload 的显存上限（GB）

# ── 模型权重路径 ─────────────────────────────────────────────
MODELS_ROOT=./models
IP_ADAPTER_MODEL_PATH=./models/ip_adapter
LIVE_PORTRAIT_MODEL_PATH=./models/live_portrait
TRIPOSR_MODEL_PATH=./models/triposr
TRIPOSR_FORCE_FLOAT32=1              # keep TripoSR in float32; set 0 only if your TripoSR path supports half
TOON_CRAFTER_MODEL_PATH=./models/toon_crafter
TOON_CRAFTER_REPO_PATH=./third_party/ToonCrafter
TOON_CRAFTER_MAX_SIDE=256
TOON_CRAFTER_DDIM_STEPS=25
TOON_CRAFTER_VIDEO_LENGTH=16
TOON_CRAFTER_PERFRAME_AE=1
TOON_CRAFTER_TIMEOUT_SEC=1800
SAM_MODEL_PATH=./models/sam/sam_vit_h_4b8939.pth

# ── HuggingFace ──────────────────────────────────────────────
HF_HOME=./models/.hf_cache
# HF_TOKEN=hf_xxxx              # 若需要访问私有模型

# ── 输出目录 ─────────────────────────────────────────────────
OUTPUT_ROOT=./outputs

# ── API 服务 ─────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1                      # 单进程，显存统一调度
